[sources.chat]
policy = "explicit_only"
allow = ["you"]

[sources.github]
policy = "candidate"
allow = ["you"]

[worker]
argv = ["@PYTHON@", "@HERE@/../scripted_agent.py", "{brief}"]

[watchdog]
stall_after_seconds = 30
repeat_limit = 3
nudge_budget = 1
restart_budget = 1

[connectors.laptop]
type = "agents"
every = "0s"
stall_after = "20m"
channel = "chat:you"
notify_detail = true
