[channels]
alerts = "chat:alerts"
brief = "chat:brief"

[brief]
hour = 8
timezone = "UTC"
stale_after = "3d"

[connectors.github]
type = "command"
every = "0s"
argv = ["@PYTHON@", "@HERE@/source.py", "@HOME@/tools.json", "github"]
confirm_argv = ["@PYTHON@", "@HERE@/source.py", "@HOME@/tools.json", "github", "{id}"]
fields = { id = "id", title = "title", status = "status" }

